{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzi Cards",
  "version": "0.3.2",
  "identifier": "com.hanzicards.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hanzi Cards",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: ws: http://localhost:* ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Mandarin flash cards",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/cedict_1_0_ts_utf-8_mdbg.txt.gz"
    ],
    "copyright": "© 2026 wjhdfnmf, MIT licence. Dictionary: CC-CEDICT (CC BY-SA 4.0, MDBG).",
    "license": "MIT AND CC-BY-SA-4.0",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "education",
        "recommends": [
          "fonts-noto-cjk",
          "gstreamer1.0-pulseaudio | gstreamer1.0-pipewire"
        ],
        "files": {
          "/usr/share/doc/hanzi-cards/LICENSE": "../LICENSE",
          "/usr/share/doc/hanzi-cards/NOTICE": "../NOTICE"
        }
      },
      "rpm": {
        "recommends": [
          "google-noto-sans-cjk-fonts",
          "gstreamer1-plugins-good"
        ],
        "files": {
          "/usr/share/licenses/hanzi-cards/LICENSE": "../LICENSE",
          "/usr/share/licenses/hanzi-cards/NOTICE": "../NOTICE"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
