{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzi Cards",
  "version": "0.2.0",
  "identifier": "com.hanzicards.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hanzi Cards",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Mandarin flash cards",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/cedict_1_0_ts_utf-8_mdbg.txt.gz"
    ],
    "copyright": "Hanzi Cards. Dictionary: CC-CEDICT (CC BY-SA 4.0, MDBG).",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
