# Maintainer: wjhdfnmf (https://github.com/wjhdfnmf)
#
# Arch Linux package for Hanzi Cards, made from the .deb on the GitHub release
# (the usual "-bin" way: nothing is compiled).
#
#   makepkg -si          build and install it
#
# After a new release: set pkgver, update the checksum with `updpkgsums`, reset pkgrel to 1,
# and refresh .SRCINFO with `makepkg --printsrcinfo > .SRCINFO`.

pkgname=hanzi-cards-bin
_appname=hanzi-cards
pkgver=0.2.1
pkgrel=1
pkgdesc="Mandarin Chinese flash cards with spaced repetition and a built-in dictionary"
arch=('x86_64')
url="https://github.com/wjhdfnmf/hanzi-cards"
# The app is MIT; the bundled CC-CEDICT dictionary is CC BY-SA 4.0.
license=('MIT' 'CC-BY-SA-4.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'glib2'
  'cairo'
  'gdk-pixbuf2'
  'dbus'
  'hicolor-icon-theme'
  'libgcc'
  'glibc'
)
optdepends=(
  'noto-fonts-cjk: Chinese characters (any CJK font works; without one they show as boxes)'
  'gst-plugins-good: microphone for spoken answers (PulseAudio)'
  'gst-plugin-pipewire: microphone for spoken answers (PipeWire)'
  'gnome-keyring: keep the AI tutor API key (or another Secret Service keyring, such as KeePassXC or KWallet)'
  'xdg-utils: "Show in folder" in Settings › Your data'
)
provides=("$_appname")
conflicts=("$_appname")
options=('!strip' '!debug')
# GitHub turns the space in "Hanzi Cards_…" into a dot
source=("$_appname-$pkgver.deb::$url/releases/download/v$pkgver/Hanzi.Cards_${pkgver}_amd64.deb")
sha256sums=('113a8250d74387e9d750a7542d3302a155b5656bf45458c2383ac1ab90e3fa7c')

package() {
  # makepkg has already unpacked the .deb into control.tar.* and data.tar.*
  bsdtar -xf data.tar.* -C "$pkgdir"
  chmod 755 "$pkgdir/usr/bin/$_appname"
  # Arch keeps licence texts under /usr/share/licenses/<package>
  install -Dm644 "$pkgdir/usr/share/doc/$_appname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  rm -r "$pkgdir/usr/share/doc"
}
