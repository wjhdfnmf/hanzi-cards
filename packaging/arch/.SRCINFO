pkgbase = hanzi-cards-bin
	pkgdesc = Mandarin Chinese flash cards with spaced repetition and a built-in dictionary
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/wjhdfnmf/hanzi-cards
	arch = x86_64
	license = MIT
	license = CC-BY-SA-4.0
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libsoup3
	depends = glib2
	depends = cairo
	depends = gdk-pixbuf2
	depends = dbus
	depends = hicolor-icon-theme
	depends = libgcc
	depends = glibc
	optdepends = noto-fonts-cjk: Chinese characters (any CJK font works; without one they show as boxes)
	optdepends = gst-plugins-good: microphone for spoken answers (PulseAudio)
	optdepends = gst-plugin-pipewire: microphone for spoken answers (PipeWire)
	optdepends = gnome-keyring: keep the AI tutor API key (or another Secret Service keyring, such as KeePassXC or KWallet)
	optdepends = xdg-utils: "Show in folder" in Settings › Your data
	provides = hanzi-cards
	conflicts = hanzi-cards
